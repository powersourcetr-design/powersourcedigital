---
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import CTABand from '@/components/sections/CTABand.astro'
import FAQ from '@/components/sections/FAQ.astro'
import { type Locale, absoluteUrl, href, localizedPath } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import Page from '@/layouts/Page.astro'
import { type BlogEntry, postSlug } from '@/lib/blog'
import { graph } from '@/lib/schema'
import { formatDate } from '@/i18n/utils'

interface Props {
  locale: Locale
  entry: BlogEntry
  related: BlogEntry[]
  /** Newest posts, for the sidebar when there are not enough related ones. */
  recent: BlogEntry[]
  /** The other locale's slug, when this post has a translation. */
  translationSlug?: string | undefined
  copy: {
    relatedTitle: string
    sidebarRelated: string
    sidebarRecent: string
    sidebarCtaTitle: string
    sidebarCtaBody: string
    sidebarCtaLabel: string
    faqEyebrow: string
    faqTitle: string
    ctaTitle: string
    ctaBody: string
    ctaLabel: string
    updated: string
    minutes: string
  }
}

const { locale, entry, related, recent, translationSlug, copy } = Astro.props
const t = useTranslations(locale)
const slug = postSlug(entry)
const path = localizedPath('blogPost', locale, slug)

const clusterKey = entry.data.cluster
const ctaHref =
  clusterKey === 'none'
    ? href(localizedPath('freeAudit', locale))
    : href(localizedPath(clusterKey, locale))

const articleSchema = {
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: locale === 'ar' ? 'ar-SA' : 'en',
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  mainEntityOfPage: absoluteUrl(path),
  author: { '@type': 'Organization', name: 'Power Source Digital' },
  publisher: { '@id': `${absoluteUrl('/')}#organization` },
  keywords: [entry.data.primaryKeyword, ...entry.data.secondaryKeywords].join(', '),
}

const shown = new Set([entry.id, ...related.map((post) => post.id)])
const topUp = recent.filter((post) => !shown.has(post.id))
const sidebarRelated = related.slice(0, 4)
const sidebarRecent = topUp.slice(0, Math.max(0, 5 - sidebarRelated.length))

const slugs = translationSlug
  ? locale === 'en'
    ? { en: slug, ar: translationSlug }
    : { en: translationSlug, ar: slug }
  : undefined
---

<Page
  locale={locale}
  routeKey="blogPost"
  title={`${entry.data.metaTitle} | Power Source Digital`}
  description={entry.data.description}
  targetSlug={translationSlug}
  slugs={slugs}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { name: t('nav.home'), path: localizedPath('home', locale) },
      { name: t('nav.blog'), path: localizedPath('blog', locale) },
      { name: entry.data.title, path },
    ]}
  />

  <div class="layout shell">
    <article class="post">
      <header>
        <h1>{entry.data.title}</h1>
        <p class="meta">
          <time datetime={entry.data.publishedAt.toISOString()}>
            {formatDate(entry.data.publishedAt, locale)}
          </time>
          <span aria-hidden="true">·</span>
          <span class="bidi-isolate">{entry.data.readingMinutes} {copy.minutes}</span>
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>

    {/* Sticky rail. Hidden below the two-column breakpoint rather than stacked,
        because the related block after the article already covers that case. */}
    <aside class="rail" aria-label={copy.sidebarRelated}>
      <div class="rail-inner">
        {
          sidebarRelated.length > 0 && (
            <nav class="rail-block">
              <h2>{copy.sidebarRelated}</h2>
              <ul>
                {sidebarRelated.map((post) => (
                  <li>
                    <a href={href(localizedPath('blogPost', locale, postSlug(post)))}>
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        {
          sidebarRecent.length > 0 && (
            <nav class="rail-block">
              <h2>{copy.sidebarRecent}</h2>
              <ul>
                {sidebarRecent.map((post) => (
                  <li>
                    <a href={href(localizedPath('blogPost', locale, postSlug(post)))}>
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="rail-cta">
          <h2>{copy.sidebarCtaTitle}</h2>
          <p>{copy.sidebarCtaBody}</p>
          <a class="rail-cta-link" href={ctaHref}>
            {copy.sidebarCtaLabel}
            <svg
              class="icon-directional"
              width="15"
              height="15"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 8h11M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </aside>
  </div>

  {
    entry.data.faq.length > 0 && (
      <FAQ eyebrow={copy.faqEyebrow} title={copy.faqTitle} items={entry.data.faq} />
    )
  }

  {
    related.length > 0 && (
      <section class="related shell">
        <h2>{copy.relatedTitle}</h2>
        <ul>
          {related.map((post) => (
            <li>
              <a href={href(localizedPath('blogPost', locale, postSlug(post)))}>
                <span class="related-title">{post.data.title}</span>
                <span class="related-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <CTABand
    locale={locale}
    title={copy.ctaTitle}
    body={copy.ctaBody}
    ctaLabel={copy.ctaLabel}
    ctaHref={ctaHref}
  />

  <script is:inline type="application/ld+json" set:html={graph([articleSchema])} />
</Page>

<style>
  .layout {
    display: grid;
    gap: 3rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) var(--section-pad);
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: 4rem;
      align-items: start;
    }
  }

  .post {
    max-inline-size: 46rem;
    min-inline-size: 0;
  }

  /* --- Sticky rail ------------------------------------------------------- */
  .rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .rail {
      display: block;
    }

    .rail-inner {
      position: sticky;
      inset-block-start: 5.5rem;
      display: grid;
      gap: 1.75rem;
      max-block-size: calc(100vh - 7rem);
      overflow-y: auto;
      /* Scrollbar only appears when the rail is genuinely taller than the
         viewport, which it will be once the blog has fifteen posts. */
      scrollbar-width: thin;
    }
  }

  .rail-block h2,
  .rail-cta h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.9rem;
  }

  :global([dir='rtl']) .rail-block h2,
  :global([dir='rtl']) .rail-cta h2 {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.92rem;
  }

  .rail-block ul {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--border-subtle);
  }

  .rail-block a {
    display: block;
    padding-block: 0.8rem;
    border-block-end: 1px solid var(--border-subtle);
    color: var(--text-default);
    font-size: 0.95rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 160ms var(--ease-out-expo);
  }

  .rail-block a:hover {
    color: var(--accent);
  }

  .rail-cta {
    padding: 1.35rem;
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    background: var(--surface-raised);
  }

  .rail-cta h2 {
    color: var(--accent);
  }

  .rail-cta p {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .rail-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .rail-cta-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  h1 {
    font-size: var(--text-h1);
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Long-form typography. Deliberately narrow measure and generous spacing —
     these pages are read, not scanned. */
  .prose {
    margin-block-start: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  :global([dir='rtl']) .prose {
    line-height: 2;
  }

  .prose :global(h2) {
    font-size: var(--text-h3);
    margin-block: 2.5rem 0.9rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-block: 2rem 0.75rem;
  }

  .prose :global(p) {
    margin-block: 0 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0 1.5rem;
    padding-inline-start: 1.35rem;
  }

  .prose :global(li) {
    margin-block-end: 0.5rem;
  }

  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--text-strong);
  }

  /* Tables scroll inside their own box rather than widening the page. */
  .prose :global(.table-wrap) {
    overflow-x: auto;
    margin-block: 0 1.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
  }

  .prose :global(table) {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.7rem 0.9rem;
    text-align: start;
    border-block-end: 1px solid var(--border-subtle);
  }

  .prose :global(th) {
    background: var(--surface-raised);
    color: var(--text-strong);
    font-weight: 600;
    white-space: nowrap;
  }

  .prose :global(tbody tr:last-child td) {
    border-block-end: 0;
  }

  .related {
    padding-block: var(--section-pad);
    border-block-start: 1px solid var(--border-subtle);
  }

  .related h2 {
    font-size: var(--text-h2);
    margin: 0 0 1.5rem;
  }

  .related ul {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related a {
    display: grid;
    gap: 0.4rem;
    block-size: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    text-decoration: none;
    transition:
      border-color 200ms var(--ease-out-expo),
      background-color 200ms var(--ease-out-expo);
  }

  .related a:hover {
    border-color: var(--border-interactive);
    background: var(--surface-raised);
  }

  .related-title {
    color: var(--text-strong);
    font-weight: 600;
  }

  .related-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
