---
import { DIR, LOCALE_TAG, SITE, type Locale, type RouteKey, alternates, href } from '@/i18n/routes'
import Analytics from '@/components/layout/Analytics.astro'
import { useTranslations } from '@/i18n/ui'
import '@/styles/global.css'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Internal pages (styleguide, thank-you) that must stay out of the index. */
  noindex?: boolean | undefined
  /** Route key, so the hreflang cluster can be generated from the route map. */
  routeKey?: RouteKey | undefined
  /** Each locale's slug, for dynamic routes. */
  slugs?: Partial<Record<Locale, string>> | undefined
}

const { locale, title, description, noindex = false, routeKey, slugs } = Astro.props
const t = useTranslations(locale)
const dir = DIR[locale]

/**
 * Self-referencing canonical, always absolute and always on the production
 * domain — never on the host that happens to be serving.
 *
 * This is what stops the temporary *.pages.dev deployment from competing with
 * powersourcedigital.com for its own content. It is deliberately not a
 * "noindex the preview" flag: a flag has to be remembered at launch, and
 * forgetting it would deindex the real site. A canonical is self-correcting.
 *
 * `Astro.url.pathname` arrives percent-encoded for Arabic routes, so it is
 * decoded before `href()` re-encodes it, keeping canonicals byte-identical to
 * the hrefs emitted elsewhere.
 */
const canonical = `${SITE}${href(decodeURI(Astro.url.pathname))}`

/**
 * The hreflang cluster, built from the route map rather than from this page's
 * own URL, so an English page and its Arabic twin cannot declare different
 * clusters. `alternates()` returns every locale plus x-default from one call —
 * there is no code path that emits one side without the other.
 *
 * Omitted on noindexed pages, which have no business in a language cluster.
 */
const languageAlternates = !noindex && routeKey ? alternates(routeKey, slugs) : []
---

<!doctype html>
<html lang={LOCALE_TAG[locale]} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      languageAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.url} />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#00a858" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Preconnect only for the Turnstile challenge, which is render-blocking
        on the landing pages. Fonts are self-hosted, so no font origins here. */}
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#content">{t('a11y.skipToContent')}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    padding: 0.75rem 1.25rem;
    background: var(--surface-raised);
    color: var(--text-strong);
    transform: translateY(-120%);
    transition: transform 150ms var(--ease-out-expo);
    z-index: 100;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
