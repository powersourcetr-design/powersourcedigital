---
import { DIR, LOCALE_TAG, SITE, type Locale, href } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import '@/styles/global.css'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Internal pages (styleguide, thank-you) that must stay out of the index. */
  noindex?: boolean
}

const { locale, title, description, noindex = false } = Astro.props
const t = useTranslations(locale)
const dir = DIR[locale]

/**
 * Self-referencing canonical, always absolute and always on the production
 * domain — never on the host that happens to be serving.
 *
 * This is what stops the temporary *.pages.dev deployment from competing with
 * powersourcedigital.com for its own content. It is deliberately not a
 * "noindex the preview" flag: a flag has to be remembered at launch, and
 * forgetting it would deindex the real site. A canonical is self-correcting.
 *
 * `Astro.url.pathname` arrives percent-encoded for Arabic routes, so it is
 * decoded before `href()` re-encodes it, keeping canonicals byte-identical to
 * the hrefs emitted elsewhere.
 */
const canonical = `${SITE}${href(decodeURI(Astro.url.pathname))}`
---

<!doctype html>
<html lang={LOCALE_TAG[locale]} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Applies the stored theme before first paint so the page never flashes
        the wrong one. Hashed into the CSP in step 6. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('psd-theme')
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored
          }
        } catch {
          /* Private mode or blocked storage: fall through to prefers-color-scheme. */
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('a11y.skipToContent')}</a>
    <main id="content">
      <slot />
    </main>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    padding: 0.75rem 1.25rem;
    background: var(--surface-raised);
    color: var(--text-strong);
    transform: translateY(-120%);
    transition: transform 150ms var(--ease-out-expo);
    z-index: 100;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
