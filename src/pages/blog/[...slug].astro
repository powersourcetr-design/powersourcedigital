---
import { render } from 'astro:content'
import Article from '@/layouts/Article.astro'
import { getPosts, postSlug, relatedPosts, translationOf } from '@/lib/blog'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (async () => {
  const posts = await getPosts('en')

  return Promise.all(
    posts.map(async (entry) => ({
      params: { slug: postSlug(entry) },
      props: {
        entry,
        related: await relatedPosts(entry),
        // The sidebar tops up with recent posts when a young cluster has few
        // related ones, so the rail is never nearly empty.
        recent: posts.slice(0, 6),
        translation: await translationOf(entry, 'ar'),
      },
    })),
  )
}) satisfies GetStaticPaths

const { entry, related, recent, translation } = Astro.props
const { Content } = await render(entry)
---

<Article
  locale="en"
  entry={entry}
  related={related}
  recent={recent}
  translationSlug={translation ? postSlug(translation) : undefined}
  copy={{
    sidebarRelated: 'Related guides',
    sidebarRecent: 'Latest guides',
    sidebarCtaTitle: 'Rather not do this yourself?',
    sidebarCtaBody: 'Fixed prices, published. See exactly what a build costs before you ask.',
    sidebarCtaLabel: 'See pricing',
    relatedTitle: 'Related reading',
    faqEyebrow: 'Questions',
    faqTitle: 'Common questions on this',
    ctaTitle: 'Want this handled for you?',
    ctaBody:
      'We build and manage this for businesses across Saudi Arabia. Fixed prices, published before you ask.',
    ctaLabel: 'See pricing',
    updated: 'Updated',
    minutes: 'min read',
  }}
>
  <Content />
</Article>
