---
import AuditScope from '@/components/sections/AuditScope.astro'
import CTABand from '@/components/sections/CTABand.astro'
import FAQ from '@/components/sections/FAQ.astro'
import Hero from '@/components/sections/Hero.astro'
import LogoStrip from '@/components/sections/LogoStrip.astro'
import ServicesGrid from '@/components/sections/ServicesGrid.astro'
import Steps from '@/components/sections/Steps.astro'
import { href, localizedPath } from '@/i18n/routes'
import Page from '@/layouts/Page.astro'
import { homepageGraph } from '@/lib/schema'

const locale = 'en' as const

const AUDIT_GROUPS = [
  {
    title: 'Your website',
    items: [
      'How fast it loads on a phone on mobile data',
      'Whether Google can crawl and index every page',
      'Titles and descriptions that are missing or duplicated',
      'Whether the Arabic version is real or machine-translated',
      'How many taps it takes to contact you',
    ],
  },
  {
    title: 'Your Google presence',
    items: [
      'Whether your Business Profile is verified and correctly categorised',
      'Duplicate or competing listings',
      'Missing services, hours, photos and attributes',
      'Reviews left unanswered',
      'Where you rank for the searches that matter near you',
    ],
  },
  {
    title: 'Your competition',
    items: [
      'The two or three businesses outranking you locally',
      'What they have that you do not',
      'Which of those gaps is worth closing first',
    ],
  },
]

const FAQ_ITEMS = [
  {
    question: 'Is the free audit actually free?',
    answer:
      'Yes. You get a written summary of what we found and what we would fix first. There is no obligation, and some of what we list will be things you can fix yourself without paying anyone.',
  },
  {
    question: 'Do we have to move our website to you?',
    answer:
      'No. Plenty of what an audit turns up can be fixed on the site you already have, by whoever currently maintains it. If a rebuild genuinely is the cheaper answer we will say so and explain why, but that is your call to make.',
  },
  {
    question: 'Do you work with businesses outside Riyadh?',
    answer:
      'Yes. We are based in Riyadh and work with businesses in Jeddah, Taif, Mecca, Al Kharj and the surrounding areas. Web and search work does not require us to be in the same city, and we will say so if a project genuinely needs an on-site visit.',
  },
  {
    question: 'Can you work in Arabic?',
    answer:
      'Both languages, and the Arabic is written rather than translated. Arabic pages get their own copy, their own typefaces and their own spacing, because Arabic set by someone who does not read it is obvious to everyone who does.',
  },
  {
    question: 'How do you charge?',
    answer:
      'Fixed price per project for build work, and a monthly retainer for ongoing SEO or store management. You see the price and what it covers before anything starts. We do not bill by the hour, because it makes the invoice a surprise.',
  },
  {
    question: 'Who owns the website when it is finished?',
    answer:
      'You do. Domain, hosting and code are all in your name, and you can move to another agency at any point without asking our permission or paying to be released.',
  },
]

const WHY = [
  {
    title: 'We start with the business',
    body: 'Before anything is designed we want to know who buys from you, what they ask before they buy, and what currently gets in the way.',
  },
  {
    title: 'Built for phones first',
    body: 'Most of your visitors arrive on a phone, often on mobile data. That is the version we build and test first, not the one we shrink down afterwards.',
  },
  {
    title: 'Search is not an add-on',
    body: 'Structure, speed and internal linking are decided while the site is being built. Retrofitting SEO afterwards costs more and works less well.',
  },
  {
    title: 'Arabic is written, not translated',
    body: 'The Arabic site is authored for a Saudi reader, with its own copy, its own type and its own spacing. Machine-translated Arabic is obvious to anyone who reads it.',
  },
]

const PROCESS = [
  {
    title: 'Look',
    body: 'We go through your site, your Google profile and the two or three competitors who outrank you, then tell you what we found. This part is free.',
  },
  {
    title: 'Plan',
    body: 'A ranked list of what to fix, with the reasoning and a price. You decide how much of it to do.',
  },
  {
    title: 'Build',
    body: 'Design, development and content, with something to review at each stage rather than a single reveal at the end.',
  },
  {
    title: 'Improve',
    body: 'After launch we track what people actually search and click, and use it to decide the next round of work.',
  },
]
---

<Page
  locale={locale}
  routeKey="home"
  title="Digital Services for Businesses in Riyadh | Power Source Digital"
  description="We build websites, improve how you appear on Google, and manage online stores for businesses in Riyadh, Jeddah, Taif and across Saudi Arabia."
>
  <Hero
    eyebrow="Riyadh · Jeddah · Taif"
    titleLead="Build a presence that"
    titleAccent="works"
    titleTail="for your business."
    body="We build professional websites, improve how you appear on Google, and manage the digital tools your customers already use to find you and get in touch."
    primaryLabel="Get a free audit"
    primaryHref={href(localizedPath('freeAudit', locale))}
    secondaryLabel="See what we do"
    secondaryHref={href(localizedPath('services', locale))}
  />

  <LogoStrip locale={locale} />

  <ServicesGrid
    locale={locale}
    eyebrow="What we do"
    title="Five services, built to work together"
    intro="Most agencies sell one of these and outsource the rest. We deliver all five in-house, which means the website, the search work and the store are decided together instead of by three companies who never speak."
  />

  <Steps
    eyebrow="Why us"
    title="What actually makes the difference"
    steps={WHY}
  />

  <Steps
    eyebrow="How we work"
    title="A process you can follow"
    intro="No long discovery phase before you see anything, and no invoice before you know what you are buying."
    steps={PROCESS}
    variant="timeline"
    tone="sunken"
  />

  <AuditScope
    eyebrow="The free audit"
    title="What we actually look at"
    intro="Every agency in Riyadh offers a free audit. Here is precisely what ours covers, so you know what you are agreeing to before you ask for it."
    groups={AUDIT_GROUPS}
    note="You get a written summary, not a sales call. Some of what we find will be things you can fix yourself, and we will tell you which ones those are."
    ctaLabel="Get a free audit"
    ctaHref={href(localizedPath('freeAudit', locale))}
  />

  <FAQ eyebrow="Questions" title="What people ask before they start" items={FAQ_ITEMS} />

  <CTABand
    locale={locale}
    title="Not sure what your business needs?"
    body="We will look at your website and your Google presence and tell you what we would fix first — including the things you can do yourself without paying anyone."
    ctaLabel="Get a free audit"
    ctaHref={href(localizedPath('freeAudit', locale))}
  />

  <script is:inline type="application/ld+json" set:html={homepageGraph(locale)} />
</Page>
