---
import Button from '@/components/ui/Button.astro'
import { href, localizedPath } from '@/i18n/routes'
import Page from '@/layouts/Page.astro'
import { PHONE_DISPLAY, PHONE_HREF, whatsappUrl } from '@/lib/whatsapp'

const locale = 'en' as const
---

<Page
  locale={locale}
  routeKey="thankYou"
  noindex
  title="Thank you | Power Source Digital"
  description="We have your request and will reply shortly."
>
  <section class="wrap shell">
    <p class="tick" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 16 16" fill="none">
        <path
          d="M3 8.4 6.2 11.6 13 4.8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </p>
    <h1>Request received.</h1>
    <p class="lead">
      We reply on WhatsApp within two working hours, Sunday to Thursday. If it is urgent,
      message us directly rather than waiting.
    </p>

    <div class="actions">
      <Button href={whatsappUrl({ locale })} size="lg" arrow>Message us now</Button>
      <Button href={href(localizedPath('home', locale))} size="lg" variant="secondary">
        Back to the homepage
      </Button>
    </div>

    <p class="call">
      Or call <a href={PHONE_HREF} class="num" dir="ltr">{PHONE_DISPLAY}</a>
    </p>
  </section>
</Page>

<script>
  // The conversion event fires here rather than on submit, so it only counts a
  // request the server actually accepted.
  window.dispatchEvent(
    new CustomEvent('psd:analytics', {
      detail: {
        event: 'form_submit',
        page: location.pathname,
        language: document.documentElement.lang.startsWith('ar') ? 'ar' : 'en',
        stage: 'confirmed',
      },
    }),
  )
</script>

<style>
  .wrap {
    max-inline-size: 44rem;
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
    text-align: start;
  }

  .tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    margin: 0 0 1.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-vivid) 14%, transparent);
    color: var(--accent);
  }

  h1 {
    font-size: var(--text-display);
    margin: 0;
  }

  .lead {
    margin: 1.25rem 0 2.25rem;
    max-inline-size: 52ch;
    font-size: var(--text-lead);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .call {
    margin: 1.75rem 0 0;
    color: var(--text-muted);
  }

  .call a {
    color: var(--accent);
  }
</style>
