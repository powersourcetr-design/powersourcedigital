---
import AuditScope from '@/components/sections/AuditScope.astro'
import CTABand from '@/components/sections/CTABand.astro'
import FAQ from '@/components/sections/FAQ.astro'
import Hero from '@/components/sections/Hero.astro'
import LogoStrip from '@/components/sections/LogoStrip.astro'
import ServicesGrid from '@/components/sections/ServicesGrid.astro'
import Steps from '@/components/sections/Steps.astro'
import { href, localizedPath } from '@/i18n/routes'
import Page from '@/layouts/Page.astro'
import { homepageGraph } from '@/lib/schema'

const locale = 'ar' as const

const AUDIT_GROUPS = [
  {
    title: 'موقعك',
    items: [
      'سرعة التحميل على الجوال وعلى شبكة البيانات',
      'قدرة جوجل على الزحف إلى صفحاتك وفهرستها',
      'العناوين والأوصاف الناقصة أو المكررة',
      'هل النسخة العربية مكتوبة فعلاً أم مترجمة آلياً',
      'كم نقرة يحتاجها العميل للتواصل معك',
    ],
  },
  {
    title: 'حضورك على جوجل',
    items: [
      'هل ملفك التجاري موثق ومصنّف بشكل صحيح',
      'الملفات المكررة أو المنافسة لملفك',
      'الخدمات وساعات العمل والصور والخصائص الناقصة',
      'التقييمات التي لم يُرد عليها',
      'ترتيبك في عمليات البحث المهمة القريبة منك',
    ],
  },
  {
    title: 'منافسوك',
    items: [
      'المنشآت التي تسبقك محلياً في النتائج',
      'ما الذي لديهم وليس لديك',
      'أي هذه الفجوات يستحق المعالجة أولاً',
    ],
  },
]

const FAQ_ITEMS = [
  {
    question: 'هل التدقيق مجاني فعلاً؟',
    answer:
      'نعم. تحصل على ملخص مكتوب بما وجدناه وما سنعالجه أولاً، دون أي التزام. وبعض ما سنذكره ستتمكن من إصلاحه بنفسك دون أن تدفع لأحد.',
  },
  {
    question: 'هل يجب أن ننقل الموقع إليكم؟',
    answer:
      'لا. كثير مما يظهره التدقيق يمكن معالجته على موقعك الحالي ومن قبل من يديره اليوم. وإذا كانت إعادة البناء هي الخيار الأقل كلفة فعلاً فسنقول ذلك ونشرح السبب، لكن القرار يبقى قرارك.',
  },
  {
    question: 'هل تعملون مع منشآت خارج الرياض؟',
    answer:
      'نعم. مقرنا الرياض ونعمل مع منشآت في جدة والطائف ومكة المكرمة والخرج والمناطق المحيطة. أعمال المواقع والبحث لا تتطلب وجودنا في المدينة نفسها، وسنخبرك بصراحة إذا احتاج المشروع زيارة ميدانية.',
  },
  {
    question: 'هل تعملون بالعربية؟',
    answer:
      'باللغتين، والعربية مكتوبة لا مترجمة. الصفحات العربية لها نصها وخطوطها وتباعدها الخاص، لأن النص العربي الذي يرتّبه من لا يقرؤه يكشفه كل من يقرؤه.',
  },
  {
    question: 'كيف تحتسبون الأسعار؟',
    answer:
      'سعر ثابت لكل مشروع في أعمال البناء، واشتراك شهري لأعمال السيو أو إدارة المتاجر المستمرة. ترى السعر وما يشمله قبل بدء أي عمل. لا نحاسب بالساعة لأن ذلك يجعل الفاتورة مفاجأة.',
  },
  {
    question: 'لمن تعود ملكية الموقع بعد الانتهاء؟',
    answer:
      'لك أنت. النطاق والاستضافة والشيفرة كلها باسمك، ويمكنك الانتقال إلى جهة أخرى في أي وقت دون إذن منا ودون رسوم إطلاق.',
  },
]

const WHY = [
  {
    title: 'نبدأ من النشاط نفسه',
    body: 'قبل أي تصميم نريد أن نعرف من يشتري منك، وما الذي يسأل عنه قبل الشراء، وما الذي يعيقه اليوم.',
  },
  {
    title: 'الجوال أولاً',
    body: 'معظم زوارك يدخلون من الجوال وعلى شبكة بيانات. هذه هي النسخة التي نبنيها ونختبرها أولاً، لا التي نُصغّرها لاحقاً.',
  },
  {
    title: 'السيو ليس إضافة لاحقة',
    body: 'البنية والسرعة والروابط الداخلية تُقرَّر أثناء بناء الموقع. معالجتها بعد الإطلاق تكلف أكثر وتعطي أقل.',
  },
  {
    title: 'العربية تُكتب ولا تُترجم',
    body: 'النسخة العربية مكتوبة لقارئ سعودي، بنصها وخطها وتباعدها الخاص. الترجمة الآلية يكشفها أي قارئ من السطر الأول.',
  },
]

const PROCESS = [
  {
    title: 'نطّلع',
    body: 'نراجع موقعك وملفك على جوجل والمنافسين الذين يسبقونك في النتائج، ثم نخبرك بما وجدناه. هذه المرحلة مجانية.',
  },
  {
    title: 'نخطط',
    body: 'قائمة مرتبة بما يجب إصلاحه، مع سبب كل بند وسعره. وأنت تقرر ما تنفذه منها.',
  },
  {
    title: 'ننفذ',
    body: 'تصميم وتطوير ومحتوى، مع مراجعة في كل مرحلة بدلاً من تسليم واحد في النهاية.',
  },
  {
    title: 'نحسّن',
    body: 'بعد الإطلاق نتابع ما يبحث عنه الناس فعلاً وما ينقرون عليه، ونبني عليه جولة العمل التالية.',
  },
]
---

<Page
  locale={locale}
  routeKey="home"
  title="خدمات رقمية للشركات في الرياض | مصدر الطاقه ديجيتال"
  description="نبني المواقع، ونحسّن ظهورك على جوجل، وندير المتاجر الإلكترونية للشركات في الرياض وجدة والطائف وفي أنحاء المملكة العربية السعودية."
>
  <Hero
    eyebrow="الرياض · جدة · الطائف"
    titleLead="حضور رقمي"
    titleAccent="يعمل"
    titleTail="لصالح نشاطك التجاري."
    body="نبني مواقع احترافية، ونحسّن طريقة ظهورك على جوجل، وندير الأدوات الرقمية التي يستخدمها عملاؤك أصلاً للوصول إليك والتواصل معك."
    primaryLabel="احصل على تدقيق مجاني"
    primaryHref={href(localizedPath('freeAudit', locale))}
    secondaryLabel="تعرّف على ما نقدمه"
    secondaryHref={href(localizedPath('services', locale))}
  />

  <LogoStrip locale={locale} />

  <ServicesGrid
    locale={locale}
    eyebrow="ما نقدمه"
    title="خمس خدمات مصممة لتعمل معاً"
    intro="معظم الشركات تبيع واحدة منها وتُسند البقية إلى غيرها. نحن ننفذ الخمس داخلياً، ما يعني أن الموقع وعمل البحث والمتجر تُقرَّر معاً لا عبر ثلاث جهات لا يتحدث بعضها إلى بعض."
  />

  <Steps eyebrow="لماذا نحن" title="ما الذي يصنع الفرق فعلاً" steps={WHY} />

  <Steps
    eyebrow="طريقة العمل"
    title="مسار واضح يمكنك متابعته"
    intro="لا مرحلة استكشاف طويلة قبل أن ترى شيئاً، ولا فاتورة قبل أن تعرف ما الذي تشتريه."
    steps={PROCESS}
    variant="timeline"
    tone="sunken"
  />

  <AuditScope
    eyebrow="التدقيق المجاني"
    title="ما الذي نطّلع عليه فعلاً"
    intro="كل شركة في الرياض تعرض تدقيقاً مجانياً. هذا بالضبط ما يشمله تدقيقنا، لتعرف ما الذي توافق عليه قبل أن تطلبه."
    groups={AUDIT_GROUPS}
    note="تحصل على ملخص مكتوب لا على مكالمة بيع. بعض ما سنجده يمكنك إصلاحه بنفسك، وسنخبرك أي البنود هي كذلك."
    ctaLabel="احصل على تدقيق مجاني"
    ctaHref={href(localizedPath('freeAudit', locale))}
  />

  <FAQ eyebrow="أسئلة" title="ما يسأل عنه العملاء قبل البدء" items={FAQ_ITEMS} />

  <CTABand
    locale={locale}
    title="لست متأكداً مما يحتاجه نشاطك؟"
    body="سنطّلع على موقعك وحضورك على جوجل ونخبرك بما سنعالجه أولاً، بما في ذلك ما يمكنك تنفيذه بنفسك دون أن تدفع لأحد."
    ctaLabel="احصل على تدقيق مجاني"
    ctaHref={href(localizedPath('freeAudit', locale))}
  />

  <script is:inline type="application/ld+json" set:html={homepageGraph(locale)} />
</Page>
