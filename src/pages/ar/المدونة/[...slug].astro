---
import { render } from 'astro:content'
import Article from '@/layouts/Article.astro'
import { getPosts, postSlug, relatedPosts, translationOf } from '@/lib/blog'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (async () => {
  const posts = await getPosts('ar')

  return Promise.all(
    posts.map(async (entry) => ({
      params: { slug: postSlug(entry) },
      props: {
        entry,
        related: await relatedPosts(entry),
        // The sidebar tops up with recent posts when a young cluster has few
        // related ones, so the rail is never nearly empty.
        recent: posts.slice(0, 6),
        translation: await translationOf(entry, 'en'),
      },
    })),
  )
}) satisfies GetStaticPaths

const { entry, related, recent, translation } = Astro.props
const { Content } = await render(entry)
---

<Article
  locale="ar"
  entry={entry}
  related={related}
  recent={recent}
  translationSlug={translation ? postSlug(translation) : undefined}
  copy={{
    sidebarRelated: 'أدلة ذات صلة',
    sidebarRecent: 'أحدث الأدلة',
    sidebarCtaTitle: 'تفضّل ألا تنفذه بنفسك؟',
    sidebarCtaBody: 'أسعار ثابتة ومنشورة. اطّلع على تكلفة التنفيذ قبل أن تسأل عنها.',
    sidebarCtaLabel: 'اطّلع على الأسعار',
    relatedTitle: 'مقالات ذات صلة',
    faqEyebrow: 'أسئلة',
    faqTitle: 'أسئلة متكررة حول هذا الموضوع',
    ctaTitle: 'تريد من ينفذ هذا نيابة عنك؟',
    ctaBody:
      'ننفذ هذا العمل وندير تفاصيله لمنشآت في أنحاء المملكة، بأسعار ثابتة منشورة قبل أن تسأل عنها.',
    ctaLabel: 'اطّلع على الأسعار',
    updated: 'آخر تحديث',
    minutes: 'دقيقة قراءة',
  }}
>
  <Content />
</Article>
