---
import { render } from 'astro:content'
import Article from '@/layouts/Article.astro'
import { getPosts, postSlug, relatedPosts, translationOf } from '@/lib/blog'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (async () => {
  const posts = await getPosts('ar')

  return Promise.all(
    posts.map(async (entry) => ({
      params: { slug: postSlug(entry) },
      props: {
        entry,
        related: await relatedPosts(entry),
        translation: await translationOf(entry, 'en'),
      },
    })),
  )
}) satisfies GetStaticPaths

const { entry, related, translation } = Astro.props
const { Content } = await render(entry)
---

<Article
  locale="ar"
  entry={entry}
  related={related}
  translationSlug={translation ? postSlug(translation) : undefined}
  copy={{
    relatedTitle: 'مقالات ذات صلة',
    faqEyebrow: 'أسئلة',
    ctaTitle: 'تريد من ينفذ هذا نيابة عنك؟',
    ctaBody:
      'ننفذ هذا العمل وندير تفاصيله لمنشآت في أنحاء المملكة، بأسعار ثابتة منشورة قبل أن تسأل عنها.',
    ctaLabel: 'اطّلع على الأسعار',
    updated: 'آخر تحديث',
    minutes: 'دقيقة قراءة',
  }}
>
  <Content />
</Article>
