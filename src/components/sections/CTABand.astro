---
import Button from '@/components/ui/Button.astro'
import type { Locale } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import { PHONE_DISPLAY, whatsappUrl } from '@/lib/whatsapp'

interface Props {
  locale: Locale
  title: string
  body: string
  ctaLabel: string
  ctaHref: string
  service?: string | undefined
  city?: string | undefined
}

const { locale, title, body, ctaLabel, ctaHref, service, city } = Astro.props
const t = useTranslations(locale)
---

<section class="band shell">
  <div class="inner">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="actions">
      <Button href={ctaHref} size="lg" arrow>{ctaLabel}</Button>
      <a
        class="wa"
        href={whatsappUrl({ locale, service, city })}
        target="_blank"
        rel="noopener"
      >
        {t('cta.whatsapp')}
        <span class="num" dir="ltr">{PHONE_DISPLAY}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: 0 var(--section-pad);
  }

  .inner {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    gap: 2rem;
    align-items: center;
    max-inline-size: var(--container-site);
    margin-inline: auto;
    padding: clamp(2rem, 1.25rem + 3vw, 3.5rem);
    border-radius: 1.75rem;
    background: var(--surface-invert);
    color: var(--color-ink-200);
  }

  /* The same bloom as the hero, so the page opens and closes on one note. */
  .inner::before {
    content: "";
    position: absolute;
    inset-block-start: -60%;
    inset-inline-start: -10%;
    inline-size: 40rem;
    aspect-ratio: 1;
    z-index: -1;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent-vivid) 20%, transparent),
      transparent 62%
    );
    pointer-events: none;
  }

  @media (min-width: 58rem) {
    .inner {
      grid-template-columns: 1fr auto;
      gap: 3.5rem;
    }
  }

  h2 {
    font-size: var(--text-h2);
    margin: 0 0 0.85rem;
    max-inline-size: 20ch;
    color: var(--text-invert);
  }

  .band p {
    margin: 0;
    color: var(--color-ink-300);
    max-inline-size: 52ch;
    font-size: var(--text-lead);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
  }

  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-300);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .wa:hover {
    color: #ffffff;
  }

  /* The panel is always dark, so the button needs the light-on-dark accent
     rather than the page accent, which is dark green on white. */
  .actions :global(.btn-primary) {
    background: var(--color-brand-400);
    color: var(--color-ink-950);
  }

  .actions :global(.btn-primary:hover) {
    background: var(--color-brand-300);
  }
</style>
