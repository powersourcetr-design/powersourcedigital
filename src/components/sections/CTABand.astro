---
import Button from '@/components/ui/Button.astro'
import type { Locale } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import { PHONE_DISPLAY, whatsappUrl } from '@/lib/whatsapp'

interface Props {
  locale: Locale
  title: string
  body: string
  ctaLabel: string
  ctaHref: string
  service?: string | undefined
  city?: string | undefined
}

const { locale, title, body, ctaLabel, ctaHref, service, city } = Astro.props
const t = useTranslations(locale)
---

<section class="band">
  <div class="inner">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="actions">
      <Button href={ctaHref} size="lg" arrow>{ctaLabel}</Button>
      <a
        class="wa"
        href={whatsappUrl({ locale, service, city })}
        target="_blank"
        rel="noopener"
      >
        {t('cta.whatsapp')}
        <span class="num" dir="ltr">{PHONE_DISPLAY}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--color-ink-950);
    color: var(--color-ink-100);
  }

  .inner {
    display: grid;
    gap: 2rem;
    align-items: center;
    max-inline-size: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem);
  }

  @media (min-width: 55rem) {
    .inner {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }

  h2 {
    font-size: var(--text-h2);
    color: #fff;
    margin: 0 0 0.7rem;
    max-inline-size: 24ch;
  }

  .band p {
    margin: 0;
    color: var(--color-ink-300);
    max-inline-size: 52ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.5rem;
  }

  /* The band is always dark, so the accent must be the light-on-dark step
     rather than the theme's `--accent`, which is dark in light mode. */
  .actions :global(.btn-primary) {
    background: var(--color-brand-400);
    color: var(--color-ink-950);
  }

  .actions :global(.btn-primary:hover) {
    background: var(--color-brand-300);
  }

  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-100);
    font-size: 0.95rem;
  }

  .wa:hover {
    color: #fff;
  }
</style>
