---
import { type FaqItem, faqPage, graph } from '@/lib/schema'

/**
 * Accordion built on native <details>/<summary>.
 *
 * No JavaScript: expand and collapse, keyboard operation and the accessible
 * open/closed state are all handled by the element. An ARIA accordion widget
 * would be more code, more to get wrong, and worse without JS.
 *
 * The FAQPage JSON-LD is generated from the same array that renders the list,
 * so the markup and the visible answer cannot disagree.
 */
interface Props {
  eyebrow: string
  title: string
  items: readonly FaqItem[]
  /** Set false on pages that already emit FAQ markup elsewhere. */
  emitSchema?: boolean | undefined
}

const { eyebrow, title, items, emitSchema = true } = Astro.props
const schema = emitSchema ? faqPage(items) : null
---

<section class="faq">
  <div class="inner">
    <header class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </header>

    <div class="list">
      {
        items.map((item) => (
          <details name="faq">
            <summary>
              <span>{item.question}</span>
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M8 3v10M3 8h10"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
            </summary>
            <div class="answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

{schema && <script is:inline type="application/ld+json" set:html={graph([schema])} />}

<style>
  .faq {
    border-block-end: 1px solid var(--border-subtle);
  }

  .inner {
    display: grid;
    gap: 2rem;
    max-inline-size: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    padding-block: var(--section-pad);
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: 22rem 1fr;
      gap: 4rem;
    }

    .head {
      position: sticky;
      inset-block-start: 6rem;
      align-self: start;
    }
  }


  h2 {
    font-size: var(--text-h2);
    margin: 0;
  }

  details {
    border-block-end: 1px solid var(--border-subtle);
  }

  details:first-child {
    border-block-start: 1px solid var(--border-subtle);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-strong);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  summary svg {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 220ms var(--ease-out-expo);
  }

  details[open] summary svg {
    transform: rotate(45deg);
  }

  .answer {
    padding-block-end: 1.3rem;
    color: var(--text-muted);
    max-inline-size: 68ch;
  }

  .answer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] .answer {
      animation: reveal 260ms var(--ease-out-expo);
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
