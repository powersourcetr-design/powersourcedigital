---
import ProjectCard from '@/components/portfolio/ProjectCard.astro'
import { FEATURED } from '@/data/portfolio'
import { type Locale, href, localizedPath } from '@/i18n/routes'

/**
 * The homepage "Selected work" slider.
 *
 * The track is a native scroller with scroll-snap, so dragging, swiping,
 * momentum, keyboard scrolling and RTL all come from the browser. The script
 * only drives the two buttons and their disabled state — a slider library here
 * would ship kilobytes to reimplement what the platform already does, and
 * would be the largest thing on the homepage.
 */
interface Props {
  locale: Locale
  copy: {
    eyebrow: string
    title: string
    intro: string
    all: string
    prev: string
    next: string
  }
}

const { locale, copy } = Astro.props
const allHref = href(localizedPath('work', locale))
---

<section class="work">
  <div class="shell">
    <header class="head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p class="intro">{copy.intro}</p>
    </header>

    <div class="controls">
      <button type="button" class="arrow" data-work-prev aria-label={copy.prev}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="icon-directional">
          <path
            d="M15 5l-7 7 7 7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="arrow" data-work-next aria-label={copy.next}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="icon-directional">
          <path
            d="M9 5l7 7-7 7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <ul class="track" data-work-track tabindex="0">
    {
      FEATURED.map((project, index) => (
        <li>
          <ProjectCard locale={locale} project={project} hover="peek" eager={index === 0} />
        </li>
      ))
    }
  </ul>

  <div class="shell">
    <a class="all" href={allHref}>
      {copy.all}
    </a>
  </div>
</section>

<script>
  /**
   * Buttons and their disabled state. Everything else is native scrolling.
   *
   * Scroll positions are read as absolute values because a right-to-left
   * scroller reports scrollLeft as negative in some engines and as a decreasing
   * positive number in others. Comparing magnitudes works in both.
   */
  const setup = () => {
    for (const track of document.querySelectorAll<HTMLElement>('[data-work-track]')) {
      const section = track.closest('section')
      if (!section || track.dataset['bound']) continue
      track.dataset['bound'] = 'true'

      const prev = section.querySelector<HTMLButtonElement>('[data-work-prev]')
      const next = section.querySelector<HTMLButtonElement>('[data-work-next]')
      const rtl = getComputedStyle(track).direction === 'rtl'

      const step = () => {
        const card = track.querySelector('li')
        return card ? card.getBoundingClientRect().width + 20 : track.clientWidth * 0.8
      }

      const update = () => {
        const max = track.scrollWidth - track.clientWidth
        const at = Math.abs(track.scrollLeft)

        // The track is padded so the first card lines up with the heading and
        // the last can still reach the edge. Under `scroll-snap-type: mandatory`
        // that padding becomes part of the resting positions: the first card
        // snaps at scrollLeft === padding, not 0, and the last stops short of
        // the maximum by the same amount. Comparing against 0 and max therefore
        // never matches, and the arrows stay enabled at both ends — which is
        // exactly what happened before this tolerance was added.
        const styles = getComputedStyle(track)
        const slack =
          Math.max(
            Number.parseFloat(styles.paddingInlineStart) || 0,
            Number.parseFloat(styles.paddingInlineEnd) || 0,
          ) + 2

        const atStart = at <= slack
        const atEnd = at >= max - slack
        prev?.setAttribute('aria-disabled', String(atStart))
        next?.setAttribute('aria-disabled', String(atEnd))
        prev?.toggleAttribute('disabled', atStart)
        next?.toggleAttribute('disabled', atEnd)
      }

      const move = (forward: boolean) => {
        const distance = step() * (forward === rtl ? -1 : 1)
        // No `behavior` here on purpose. The animation belongs to CSS
        // `scroll-behavior`, which the reduced-motion query already turns off.
        // Passing `behavior: 'smooth'` makes the scroll depend on the engine
        // honouring programmatic smooth scrolling, and where it does not the
        // button silently does nothing at all.
        // ScrollToOptions has no logical member: `left` is the only inline axis
        // the DOM exposes. Direction is handled where `distance` is negated.
        track.scrollBy({ left: distance }) // dir-ok

        // The scroll event is the primary signal, but it is asynchronous and
        // some engines do not emit it for programmatic scrolls at all. Without
        // this the buttons keep the state they had at page load, so the arrow
        // at the end of the track never greys out. Re-checking after the
        // animation would have finished costs one timer and removes that
        // dependency entirely.
        window.setTimeout(update, 500)
      }

      prev?.addEventListener('click', () => move(false))
      next?.addEventListener('click', () => move(true))
      track.addEventListener('scroll', update, { passive: true })
      window.addEventListener('resize', update)
      update()
    }
  }

  setup()
  document.addEventListener('astro:after-swap', setup)
</script>

<style>
  .work {
    padding-block: var(--section-pad);
    border-block-end: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .head {
    max-inline-size: 46rem;
  }

  h2 {
    font-size: var(--text-h2);
    margin: 0 0 0.9rem;
    max-inline-size: 22ch;
  }

  .intro {
    margin: 0;
    color: var(--text-muted);
    max-inline-size: 60ch;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    margin-block: 1.5rem 1.25rem;
  }

  .arrow {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-default);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .arrow:hover:not([disabled]) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  /* The track breaks out of .shell so cards can bleed to the viewport edge,
     while the first card still lines up with the heading above it. */
  .track {
    list-style: none;
    scroll-behavior: smooth;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding-inline: max(var(--spacing-gutter), calc((100vw - var(--container-site)) / 2));
    padding-block: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track > li {
    flex: 0 0 auto;
    inline-size: min(78vw, 20rem);
    scroll-snap-align: start;
  }

  @media (min-width: 48rem) {
    .track > li {
      inline-size: 34vw;
    }
  }

  @media (min-width: 62rem) {
    .track > li {
      /* 3.4 cards visible, so the fourth peeks and the track reads as scrollable. */
      inline-size: calc((min(100vw, var(--container-site)) - 2 * var(--spacing-gutter)) / 3.4);
    }
  }

  .all {
    display: inline-block;
    margin-block-start: 1.5rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-block-end: 1px solid transparent;
  }

  .all:hover,
  .all:focus-visible {
    border-block-end-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>
