---
import LeadForm from '@/components/sections/LeadForm.astro'
import Button from '@/components/ui/Button.astro'
import type { Locale } from '@/i18n/routes'

/**
 * The hero carries the whole first impression, so it is deliberately the
 * loudest thing on the site: display type at up to 120px, one accent word, and
 * a slow glow behind it.
 *
 * The glow is a GPU-composited radial gradient on its own layer. It never
 * becomes the LCP element — the heading is — and it is not animated on the
 * paint-critical property.
 */
interface Props {
  locale: Locale
  /** Heading shown above the hero form. */
  formTitle: string
  eyebrow: string
  /** Rendered before the accent word. */
  titleLead: string
  /** The one word or phrase set in the brand green. */
  titleAccent: string
  /** Rendered after the accent word. */
  titleTail: string
  body: string
  primaryLabel: string
  primaryHref: string
  secondaryLabel: string
  secondaryHref: string
}

const {
  locale,
  formTitle,
  eyebrow,
  titleLead,
  titleAccent,
  titleTail,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="grid-lines" aria-hidden="true"></div>

  <div class="shell inner">
    <div class="pitch">
      <p class="eyebrow">{eyebrow}</p>

      <h1>
        {titleLead}{' '}<em>{titleAccent}</em>{' '}{titleTail}
      </h1>

      <p class="lead">{body}</p>

      <div class="actions">
        <Button href={primaryHref} size="lg" arrow>{primaryLabel}</Button>
        <Button href={secondaryHref} size="lg" variant="secondary">{secondaryLabel}</Button>
      </div>
    </div>

    <div class="form-column">
      <LeadForm locale={locale} source="homepage-hero" title={formTitle} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* A single large radial bloom behind the headline. */
  .glow {
    position: absolute;
    inset-block-start: -30%;
    inset-inline-end: -10%;
    inline-size: min(70rem, 120%);
    aspect-ratio: 1;
    z-index: -2;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent-vivid) 17%, transparent),
      color-mix(in srgb, var(--color-sand-300) 20%, transparent) 45%,
      transparent 70%
    );
    filter: blur(24px);
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glow {
      animation: bloom 18s ease-in-out infinite alternate;
    }
  }

  @keyframes bloom {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.85;
    }
    to {
      transform: translate3d(-4%, 3%, 0) scale(1.12);
      opacity: 1;
    }
  }

  /* Faint vertical rules, the printed-grid cue agency sites use to signal
     that the layout is deliberate. */
  .grid-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    max-inline-size: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    background-image: linear-gradient(
      to right,
      var(--border-subtle) 1px,
      transparent 1px
    );
    background-size: 25% 100%;
    background-clip: content-box;
    opacity: 1;
    mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 68%, transparent);
  }

  .inner {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 1.5rem + 5vw, 5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  /* The form joins the hero only when there is genuine room for it. Below this
     it drops under the pitch, which keeps the headline the first thing read on
     a phone rather than a wall of inputs. */
  @media (min-width: 64rem) {
    .inner {
      grid-template-columns: minmax(0, 1.15fr) 26rem;
      gap: 4rem;
      align-items: center;
    }
  }

  .pitch {
    min-inline-size: 0;
  }

  h1 {
    font-size: var(--text-display);
    line-height: 1.02;
    margin: 0;
    max-inline-size: 14ch;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  /* Arabic sets visually larger and denser than Latin at the same size, and its
     ascenders and descenders need real room. The Latin mega scale would be
     shouting here, so Arabic gets its own smaller ramp and looser leading —
     the two look equally confident, which is the point, rather than equally
     sized, which is not. */
  [dir="rtl"] h1 {
    font-size: clamp(2rem, 1rem + 4.2vw, 3.75rem);
    line-height: 1.36;
    max-inline-size: 17ch;
  }

  .lead {
    margin-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) clamp(2rem, 1.5rem + 2vw, 3rem);
    max-inline-size: 54ch;
    font-size: var(--text-lead);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

</style>
