---
import Button from '@/components/ui/Button.astro'

/**
 * The hero carries the whole first impression, so it is deliberately the
 * loudest thing on the site: display type at up to 120px, one accent word, and
 * a slow glow behind it.
 *
 * The glow is a GPU-composited radial gradient on its own layer. It never
 * becomes the LCP element — the heading is — and it is not animated on the
 * paint-critical property.
 */
interface Props {
  eyebrow: string
  /** Rendered before the accent word. */
  titleLead: string
  /** The one word or phrase set in the brand green. */
  titleAccent: string
  /** Rendered after the accent word. */
  titleTail: string
  body: string
  primaryLabel: string
  primaryHref: string
  secondaryLabel: string
  secondaryHref: string
  stats: { value: string; label: string }[]
}

const {
  eyebrow,
  titleLead,
  titleAccent,
  titleTail,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  stats,
} = Astro.props
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="grid-lines" aria-hidden="true"></div>

  <div class="shell inner">
    <p class="eyebrow">{eyebrow}</p>

    <h1>
      {titleLead}{' '}<em>{titleAccent}</em>{' '}{titleTail}
    </h1>

    <p class="lead">{body}</p>

    <div class="actions">
      <Button href={primaryHref} size="lg" arrow>{primaryLabel}</Button>
      <Button href={secondaryHref} size="lg" variant="secondary">{secondaryLabel}</Button>
    </div>

    <dl class="stats">
      {
        stats.map((stat) => (
          <div>
            <dt class="num">{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* A single large radial bloom behind the headline. */
  .glow {
    position: absolute;
    inset-block-start: -30%;
    inset-inline-end: -10%;
    inline-size: min(70rem, 120%);
    aspect-ratio: 1;
    z-index: -2;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent-vivid) 17%, transparent),
      color-mix(in srgb, var(--color-sand-300) 20%, transparent) 45%,
      transparent 70%
    );
    filter: blur(24px);
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glow {
      animation: bloom 18s ease-in-out infinite alternate;
    }
  }

  @keyframes bloom {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.85;
    }
    to {
      transform: translate3d(-4%, 3%, 0) scale(1.12);
      opacity: 1;
    }
  }

  /* Faint vertical rules, the printed-grid cue agency sites use to signal
     that the layout is deliberate. */
  .grid-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    max-inline-size: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    background-image: linear-gradient(
      to right,
      var(--border-subtle) 1px,
      transparent 1px
    );
    background-size: 25% 100%;
    background-clip: content-box;
    opacity: 1;
    mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 68%, transparent);
  }

  .inner {
    padding-block: clamp(4rem, 2rem + 10vw, 9rem) clamp(3rem, 2rem + 5vw, 6rem);
  }

  h1 {
    font-size: var(--text-mega);
    line-height: 0.98;
    margin: 0;
    max-inline-size: 15ch;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  /* Arabic sets visually larger and denser than Latin at the same size, and its
     ascenders and descenders need real room. The Latin mega scale would be
     shouting here, so Arabic gets its own smaller ramp and looser leading —
     the two look equally confident, which is the point, rather than equally
     sized, which is not. */
  [dir="rtl"] h1 {
    font-size: clamp(2.25rem, 1rem + 5.4vw, 4.75rem);
    line-height: 1.34;
    max-inline-size: 18ch;
  }

  .lead {
    margin-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) clamp(2rem, 1.5rem + 2vw, 3rem);
    max-inline-size: 54ch;
    font-size: var(--text-lead);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1.75rem;
    margin: clamp(3.5rem, 2rem + 6vw, 6rem) 0 0;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  .stats div {
    display: grid;
    gap: 0.35rem;
  }

  .stats dt {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1;
  }

  .stats dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
