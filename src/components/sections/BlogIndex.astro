---
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'
import { type Locale, href, localizedPath } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import { formatDate } from '@/i18n/utils'
import { type BlogEntry, postSlug } from '@/lib/blog'

/**
 * The index reads as one featured article and then a grid, rather than a flat
 * list where every post carries equal weight.
 *
 * A flat list makes the reader do all of the choosing, and that gets worse the
 * more we publish. Promoting the newest article gives the page an entry point,
 * and gives the most recent work the internal link equity of the largest
 * element on the page.
 */
interface Props {
  locale: Locale
  posts: BlogEntry[]
  copy: {
    eyebrow: string
    title: string
    lead: string
    minutes: string
    empty: string
    /** Label above the promoted article. */
    featured: string
    /** Heading over the grid below it. */
    more: string
  }
}

const { locale, posts, copy } = Astro.props
const t = useTranslations(locale)

const [featured, ...rest] = posts
const postHref = (post: BlogEntry) => href(localizedPath('blogPost', locale, postSlug(post)))
---

<Breadcrumbs
  locale={locale}
  items={[
    { name: t('nav.home'), path: localizedPath('home', locale) },
    { name: t('nav.blog'), path: localizedPath('blog', locale) },
  ]}
/>

<section class="head shell">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.title}</h1>
  <p class="lead">{copy.lead}</p>
</section>

{
  posts.length === 0 ? (
    <section class="shell">
      <p class="empty">{copy.empty}</p>
    </section>
  ) : (
    <>
      {featured && (
        <section class="shell featured-wrap">
          <p class="eyebrow small">{copy.featured}</p>
          <a class="featured" href={postHref(featured)}>
            <ul class="tags" aria-hidden="true">
              {featured.data.tags.slice(0, 3).map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <h2>{featured.data.title}</h2>
            <p class="desc">{featured.data.description}</p>
            <p class="meta">
              <time datetime={featured.data.publishedAt.toISOString()}>
                {formatDate(featured.data.publishedAt, locale)}
              </time>
              <span aria-hidden="true">·</span>
              <span class="bidi-isolate">
                {featured.data.readingMinutes} {copy.minutes}
              </span>
            </p>
          </a>
        </section>
      )}

      {rest.length > 0 && (
        <section class="shell list">
          <h2 class="more">{copy.more}</h2>
          <ul class="grid">
            {rest.map((post) => (
              <li>
                <a href={postHref(post)}>
                  <ul class="tags" aria-hidden="true">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <h3>{post.data.title}</h3>
                  <p class="desc">{post.data.description}</p>
                  <p class="meta">
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {formatDate(post.data.publishedAt, locale)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span class="bidi-isolate">
                      {post.data.readingMinutes} {copy.minutes}
                    </span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )
}

<style>
  .head {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) 2.25rem;
  }

  h1 {
    font-size: var(--text-display);
    margin: 0 0 1rem;
    max-inline-size: 20ch;
  }

  .lead {
    margin: 0;
    max-inline-size: 60ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .eyebrow.small {
    margin-block-end: 0.9rem;
  }

  .featured-wrap {
    padding-block-end: 2.5rem;
  }

  /* The promoted card sits on the raised surface so it reads as one object
     rather than as the first row of the list that follows it. */
  .featured {
    display: block;
    border: 1px solid var(--border-subtle);
    border-radius: 1.25rem;
    background: var(--surface-raised);
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .featured:hover,
  .featured:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .featured h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
    margin: 0 0 0.75rem;
    max-inline-size: 24ch;
    line-height: 1.2;
  }

  .featured .desc {
    font-size: 1.05rem;
    max-inline-size: 62ch;
  }

  .list {
    padding-block-end: var(--section-pad);
  }

  .more {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 1.25rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--border-subtle);
  }

  /* Arabic is cursive: uppercasing and tracking both damage it. */
  :global([dir='rtl']) .more {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.95rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
  }

  .grid > li > a {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    padding: 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .grid > li > a:hover,
  .grid > li > a:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .grid h3 {
    font-size: 1.15rem;
    line-height: 1.35;
    margin: 0 0 0.6rem;
  }

  .desc {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Pushes the date to the foot of the card, so a short summary and a long one
     still line their meta rows up across a row of cards. */
  .grid .desc {
    flex: 1;
    font-size: 0.95rem;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .tags li {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-vivid) 8%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }

  :global([dir='rtl']) .tags li {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.8rem;
  }

  .empty {
    padding-block: 3rem var(--section-pad);
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured,
    .grid > li > a {
      transition: none;
    }

    .featured:hover,
    .grid > li > a:hover {
      transform: none;
    }
  }
</style>
