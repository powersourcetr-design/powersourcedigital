---
import { type Locale, href } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import { type Crumb, breadcrumbs, graph } from '@/lib/schema'

/**
 * Visible breadcrumbs plus the matching BreadcrumbList, generated from one
 * array so the trail on screen and the trail Google reads cannot disagree.
 *
 * The last crumb is the current page: rendered as text, not a link, and marked
 * `aria-current="page"`.
 */
interface Props {
  locale: Locale
  items: Crumb[]
}

const { locale, items } = Astro.props
const t = useTranslations(locale)
const schema = breadcrumbs(items)
---

<nav class="crumbs shell" aria-label={t('a11y.breadcrumb')}>
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1
        return (
          <li>
            {isLast ? (
              <span aria-current="page">{item.name}</span>
            ) : (
              <a href={href(item.path)}>{item.name}</a>
            )}
            {!isLast && (
              <svg
                class="icon-directional"
                width="12"
                height="12"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </li>
        )
      })
    }
  </ol>
</nav>

{schema && <script is:inline type="application/ld+json" set:html={graph([schema])} />}

<style>
  .crumbs {
    padding-block: 1.25rem 0;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  span[aria-current='page'] {
    color: var(--text-strong);
  }

  svg {
    opacity: 0.5;
  }
</style>
