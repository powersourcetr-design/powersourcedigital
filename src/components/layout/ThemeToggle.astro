---
import type { Locale } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<button type="button" class="theme" data-theme-toggle aria-label={t('a11y.themeToggle')}>
  <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle class="sun" cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.3"></circle>
    <path
      class="rays"
      d="M8 .9v1.6M8 13.5v1.6M15.1 8h-1.6M2.5 8H.9M13 3l-1.1 1.1M4.1 11.9 3 13M13 13l-1.1-1.1M4.1 4.1 3 3"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"></path>
    <path
      class="moon"
      d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8Z"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const resolved = () =>
    document.documentElement.dataset['theme'] ??
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')

  const sync = () => {
    const isDark = resolved() === 'dark'
    for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
      button.dataset['mode'] = isDark ? 'dark' : 'light'
    }
  }

  const bind = () => {
    for (const button of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
      if (button.dataset['bound']) continue
      button.dataset['bound'] = 'true'
      button.addEventListener('click', () => {
        const next = resolved() === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset['theme'] = next
        try {
          localStorage.setItem('psd-theme', next)
        } catch {
          /* Storage blocked; the toggle still works for this page view. */
        }
        sync()
      })
    }
    sync()
  }

  bind()
  document.addEventListener('astro:after-swap', bind)
</script>

<style>
  .theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--text-default);
    cursor: pointer;
    transition: background-color 180ms var(--ease-out-expo);
  }

  .theme:hover {
    background: var(--surface-raised);
    color: var(--text-strong);
  }

  /* Default to the sun; JS swaps `data-mode` once it knows the resolved theme.
     Without JS the sun simply stays, which is a harmless static icon. */
  .moon {
    display: none;
  }

  .theme[data-mode='dark'] .sun,
  .theme[data-mode='dark'] .rays {
    display: none;
  }

  .theme[data-mode='dark'] .moon {
    display: block;
  }
</style>
