---
import { type Locale, type RouteKey, href, isLive, localizedPath } from '@/i18n/routes'
import { servicePath } from '@/i18n/slugs'
import { useTranslations } from '@/i18n/ui'
import { getServices, serviceKeyOf } from '@/lib/content'
import { EMAIL, PHONE_DISPLAY, PHONE_HREF, whatsappUrl } from '@/lib/whatsapp'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

// Service names come from the content collection so the footer cannot list a
// service whose page does not exist.
const services = await getServices(locale)
const year = new Date().getFullYear()

// Same rule as the header: the footer never links at a route without a page.
const COMPANY: { key: RouteKey; label: Parameters<typeof t>[0] }[] = (
  [
    { key: 'about', label: 'nav.about' },
    { key: 'work', label: 'nav.work' },
    { key: 'process', label: 'nav.process' },
    { key: 'pricing', label: 'nav.pricing' },
    { key: 'blog', label: 'nav.blog' },
    { key: 'contact', label: 'nav.contact' },
  ] as { key: RouteKey; label: Parameters<typeof t>[0] }[]
).filter((item) => isLive(item.key))

const LEGAL: { key: RouteKey; label: Parameters<typeof t>[0] }[] = (
  [
    { key: 'privacy', label: 'footer.privacy' },
    { key: 'terms', label: 'footer.terms' },
  ] as { key: RouteKey; label: Parameters<typeof t>[0] }[]
).filter((item) => isLive(item.key))
---

<footer class="footer">
  <div class="inner">
    <div class="about">
      <span class="wordmark">
        <strong>{locale === 'ar' ? 'مصدر الطاقه ديجيتال' : 'Power Source Digital'}</strong>
      </span>
      <p>{t('footer.about')}</p>
    </div>

    <nav class="col" aria-labelledby="f-services">
      <h2 id="f-services">{t('footer.services')}</h2>
      {
        services.map((entry) => (
          <a href={href(servicePath(serviceKeyOf(entry), locale))}>{entry.data.title}</a>
        ))
      }
    </nav>

    <nav class="col" aria-labelledby="f-company">
      <h2 id="f-company">{t('footer.company')}</h2>
      {
        COMPANY.map((item) => (
          <a href={href(localizedPath(item.key, locale))}>{t(item.label)}</a>
        ))
      }
    </nav>

    <div class="col">
      <h2>{t('footer.talk')}</h2>
      <a href={whatsappUrl({ locale })} target="_blank" rel="noopener">
        {t('contact.whatsapp')} — <span class="num" dir="ltr">{PHONE_DISPLAY}</span>
      </a>
      <a href={PHONE_HREF}>
        {t('contact.phone')} — <span class="num" dir="ltr">{PHONE_DISPLAY}</span>
      </a>
      <a href={`mailto:${EMAIL}`}><span dir="ltr">{EMAIL}</span></a>
      <p class="place">{t('contact.location')}</p>
    </div>
  </div>

  <div class="base">
    <p><span class="num" dir="ltr">©&nbsp;{year}</span> Power Source Digital. {t('footer.rights')}</p>
    {
      LEGAL.length > 0 && (
        <nav aria-label={t('footer.legal')}>
          {LEGAL.map((item) => (
            <a href={href(localizedPath(item.key, locale))}>{t(item.label)}</a>
          ))}
        </nav>
      )
    }
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-raised);
    border-block-start: 1px solid var(--border-subtle);
  }

  .inner {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    max-inline-size: var(--container-site);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    padding-block: clamp(2.5rem, 1.75rem + 2.4vw, 3.5rem);
  }

  @media (min-width: 40rem) {
    .inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Four columns on desktop: the description takes the wide first one and the
     three link groups follow, so "Let's talk" is the fourth column rather than
     wrapping under the description. */
  @media (min-width: 62rem) {
    .inner {
      grid-template-columns: 1.6fr 1fr 1fr 1.1fr;
      gap: 3rem;
    }

    .about {
      padding-inline-end: 2rem;
    }
  }

  .wordmark {
    display: block;
    margin-block-end: 1rem;
  }

  .wordmark strong {
    font-size: 1.05rem;
    color: var(--text-strong);
  }

  .about p {
    color: var(--text-muted);
    max-inline-size: 44ch;
    margin: 0 0 0.9rem;
  }

  .col {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .col h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0 0 0.3rem;
  }

  :global([dir='rtl']) .col h2 {
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.85rem;
  }

  .col a {
    color: var(--text-default);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .col a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .place {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .base {
    border-block-start: 1px solid var(--border-subtle);
  }

  .base > * {
    max-inline-size: var(--container-site);
    margin-inline: auto;
  }

  .base {
    display: grid;
    gap: 0.5rem;
    padding-inline: var(--spacing-gutter);
    padding-block: 1.5rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .base nav {
    display: flex;
    gap: 1.25rem;
  }

  .base a {
    color: var(--text-muted);
  }

  @media (min-width: 700px) {
    .base {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  /* Clears the mobile action bar. */
  @media (max-width: 767px) {
    .base {
      padding-block-end: 5rem;
    }
  }
</style>
