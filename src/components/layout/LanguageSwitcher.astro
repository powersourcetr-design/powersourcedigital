---
import {
  type Locale,
  type RouteKey,
  href,
  isLive,
  localizedPath,
  otherLocale,
} from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'

/**
 * Switches to the *equivalent* page in the other language, never the homepage.
 *
 * The target is built from the route key and the other locale's slug, both of
 * which the page passes in, so the pair cannot drift from what hreflang
 * declares. A page that genuinely has no twin falls back to its section index
 * rather than dumping the reader on the homepage.
 */
interface Props {
  locale: Locale
  routeKey: RouteKey
  /** The other locale's slug, for dynamic routes. */
  targetSlug?: string | undefined
  class?: string | undefined
}

const { locale, routeKey, targetSlug, class: className } = Astro.props
const t = useTranslations(locale)
const target = otherLocale(locale)

// If this route has no page in the other language — the 404 pages are the live
// case — fall back to that locale's home rather than linking into a 404. The
// brief calls for the section index; home is the section index for a page that
// is not in a section.
const targetKey: RouteKey = isLive(routeKey) ? routeKey : 'home'
const path = localizedPath(targetKey, target, isLive(routeKey) ? targetSlug : undefined)
---

<a
  class:list={['lang', className]}
  href={href(path)}
  hreflang={target === 'ar' ? 'ar-SA' : 'en'}
  lang={target}
  dir={target === 'ar' ? 'rtl' : 'ltr'}
  aria-label={t('lang.switchToAria')}
>
  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.3"></circle>
    <path
      d="M1.6 8h12.8M8 1.6c1.7 1.8 2.6 4 2.6 6.4S9.7 12.6 8 14.4C6.3 12.6 5.4 10.4 5.4 8S6.3 3.4 8 1.6Z"
      stroke="currentColor"
      stroke-width="1.3"></path>
  </svg>
  <span>{t('lang.switchTo')}</span>
</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    color: var(--text-default);
    text-decoration: none;
    font-size: 0.9rem;
    transition: background-color 180ms var(--ease-out-expo);
  }

  .lang:hover {
    background: var(--surface-raised);
    color: var(--text-strong);
  }

  .lang svg {
    flex-shrink: 0;
    opacity: 0.75;
  }
</style>
