---
import { type Locale, href, localizedPath } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import { PHONE_HREF, whatsappUrl } from '@/lib/whatsapp'

/**
 * Bottom bar under 768px: call, WhatsApp, free audit.
 * Hides on scroll down and returns on scroll up, so it never sits on top of
 * what someone is reading.
 */
interface Props {
  locale: Locale
  service?: string | undefined
  city?: string | undefined
}

const { locale, service, city } = Astro.props
const t = useTranslations(locale)
---

<div class="bar" data-action-bar aria-label={t('a11y.quickActions')}>
  <a href={PHONE_HREF} data-track="phone_click">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6.6 3h3l1.5 3.7-2 1.4a12 12 0 0 0 5.4 5.4l1.4-2 3.7 1.5v3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
    <span>{t('cta.call')}</span>
  </a>

  <a
    href={whatsappUrl({ locale, service, city })}
    target="_blank"
    rel="noopener"
    data-track="whatsapp_click"
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12.04 2A9.94 9.94 0 0 0 2.1 11.94c0 1.75.46 3.46 1.33 4.97L2 22l5.23-1.37a9.9 9.9 0 0 0 4.8 1.22 9.94 9.94 0 0 0 0-19.85Zm0 18.2a8.25 8.25 0 0 1-4.2-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.26 8.26 0 1 1 6.98 3.85Z"
      ></path>
      <path
        d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.95 1.16-.17.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.07-.13-.27-.2-.57-.35Z"
      ></path>
    </svg>
    <span>{t('cta.whatsapp')}</span>
  </a>

  <a class="primary" href={href(localizedPath('freeAudit', locale))}>
    <span>{t('cta.freeAuditShort')}</span>
  </a>
</div>

<script>
  const setup = () => {
    const bar = document.querySelector<HTMLElement>('[data-action-bar]')
    if (!bar) return

    let last = window.scrollY

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY
        // Ignore the rubber-band region at the top, where direction flips noisily.
        if (y > 120) {
          bar.dataset['hidden'] = String(y > last)
        } else {
          bar.dataset['hidden'] = 'false'
        }
        last = y
      },
      { passive: true },
    )

    for (const link of bar.querySelectorAll<HTMLAnchorElement>('[data-track]')) {
      link.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('psd:analytics', {
            detail: { event: link.dataset['track'], page: location.pathname },
          }),
        )
      })
    }
  }

  setup()
  document.addEventListener('astro:after-swap', setup)
</script>

<style>
  .bar {
    display: none;
  }

  @media (max-width: 767px) {
    .bar {
      position: fixed;
      inset-block-end: 0;
      inset-inline: 0;
      z-index: 55;

      display: grid;
      grid-template-columns: auto auto 1fr;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem var(--spacing-gutter);
      padding-block-end: max(0.6rem, env(safe-area-inset-bottom));

      background: color-mix(in srgb, var(--surface) 92%, transparent);
      backdrop-filter: blur(12px);
      border-block-start: 1px solid var(--border-subtle);

      transition: transform 260ms var(--ease-out-expo);
    }

    .bar[data-hidden='true'] {
      transform: translateY(110%);
    }

    .bar a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.7rem 0.9rem;
      border-radius: 999px;
      color: var(--text-default);
      text-decoration: none;
      font-size: 0.9rem;
      border: 1px solid var(--border-subtle);
    }

    .bar .primary {
      background: var(--accent);
      color: var(--accent-contrast);
      border-color: transparent;
      font-weight: 500;
    }
  }
</style>
