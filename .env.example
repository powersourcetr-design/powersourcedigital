# Cloudflare Pages environment variables for the lead endpoint.
# Set these in the Pages project settings, not in a committed file.
# See SETUP.md section 2.

# Resend API key. Leave unset to fall back to MailChannels, which needs no key
# but requires a DNS record proving you own the sending domain.
LEAD_EMAIL_KEY=

# Where leads are delivered.
LEAD_EMAIL_TO=hello@powersourcedigital.com

# Must be an address on a domain verified with the sending provider. An
# unverified from-address is silently spam-foldered.
LEAD_EMAIL_FROM=website@powersourcedigital.com

# Secret half of the Turnstile pair. The site key is public and lives in
# src/lib/analytics.ts.
TURNSTILE_SECRET_KEY=

# Bindings (created in the Cloudflare dashboard, not set as plain variables):
#   LEADS_KV — KV namespace. Every lead is written here before the email is
#              attempted, so a mail outage never loses an enquiry.
