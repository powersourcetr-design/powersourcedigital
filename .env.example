# Environment variables for the lead endpoint (/api/lead).
# Set these in the Cloudflare project settings, not in a committed file.
# See SETUP.md section 2.

# Resend API key. https://resend.com → API Keys.
#
# NOTE: an earlier version of this file said an unset key falls back to
# MailChannels. It does not. MailChannels withdrew free sending from Cloudflare
# Workers in June 2024, so there is no keyless mail path any more. With this
# unset, leads are still written to KV and the visitor still sees success —
# but nothing arrives in an inbox and you have to read them out of KV.
LEAD_EMAIL_KEY=

# Where leads are delivered.
LEAD_EMAIL_TO=hello@powersourcedigital.com

# Must be an address on a domain verified with Resend. An unverified
# from-address is rejected outright or silently spam-foldered.
LEAD_EMAIL_FROM=website@powersourcedigital.com

# Secret half of the Turnstile pair. The site key is public and lives in
# src/lib/analytics.ts.
#
# While this is unset, verification is SKIPPED so the form keeps working — the
# widget renders but proves nothing. Set it before the site gets real traffic.
TURNSTILE_SECRET_KEY=

# Bindings (created in the Cloudflare dashboard, not set as plain variables):
#   LEADS_KV — KV namespace. Every lead is written here before the email is
#              attempted, so a mail outage never loses an enquiry. It also
#              backs the per-IP rate limit; without it, both are skipped.
